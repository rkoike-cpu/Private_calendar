1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=4;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1161" y="300" width="78" height="78" as="geometry"/></mxCell><mxCell id="ec2_c" value="EC2 (t3.small)&lt;br&gt;Next.js :3000&lt;br&gt;Go API :8080" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="880" y="670" width="78" height="78" as="geometry"/></mxCell><mxCell id="rds_c" value="RDS PostgreSQL&lt;br&gt;スタンバイ" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=4;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1161" y="670" width="78" height="78" as="geometry"/></mxCell><mxCell id="iam" value="IAM ロール&lt;br&gt;(EC2に付与)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="600" y="920" width="60" height="60" as="geometry"/></mxCell><mxCell id="ssm" value="Systems Manager&lt;br&gt;Parameter Store" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="840" y="920" width="60" height="60" as="geometry"/></mxCell><mxCell id="cwl" value="CloudWatch Logs" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="970" y="920" width="60" height="60" as="geometry"/></mxCell><mxCell id="user" value="利用者&lt;br&gt;(スマホ / 会社PC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="40" y="481" width="78" height="78" as="geometry"/></mxCell><mxCell id="cf" value="CloudFront&lt;br&gt;*.cloudfront.net&lt;br&gt;HTTPS終端&lt;br&gt;(キャッシュなし)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="200" y="490" width="60" height="60" as="geometry"/></mxCell><mxCell id="extbox" value="外部サービス (EC2からInternet Gateway経由で直接呼び出す)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#545B64;fillColor=#FAFAFA;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="330" y="1070" width="560" height="125" as="geometry"/></mxCell><mxCell id="gcal" value="Google&lt;br&gt;Calendar API / OAuth" style="sketch=0;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;shape=mxgraph.aws4.traditional_server;fillColor=#7D8998;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="400" y="1100" width="45" height="45" as="geometry"/></mxCell><mxCell id="wapi" value="WeatherAPI.com" style="sketch=0;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;shape=mxgraph.aws4.traditional_server;fillColor=#7D8998;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="590" y="1100" width="45" height="45" as="geometry"/></mxCell><mxCell id="wpush" value="Web Push&lt;br&gt;(FCM等)" style="sketch=0;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;shape=mxgraph.aws4.traditional_server;fillColor=#7D8998;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="770" y="1100" width="45" height="45" as="geometry"/></mxCell><mxCell id="sgnote" value="セキュリティグループ&lt;br&gt;&lt;br&gt;ALB  : 80 ← CloudFront のみ&lt;br&gt;       (AWS管理プレフィックスリスト)&lt;br&gt;EC2  : 3000 ← ALB のSGのみ&lt;br&gt;RDS  : 5432 ← EC2 のSGのみ&lt;br&gt;&lt;br&gt;EC2はパブリックIPを持つが、上記以外の&lt;br&gt;内向き通信はすべて拒否する。&lt;br&gt;Go API の 8080 は外部に公開しない" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#545B64;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="290" height="180" as="geometry"/></mxCell><mxCell id="flownote" value="リクエストの流れ&lt;br&gt;&lt;br&gt;CloudFront (HTTPS終端)&lt;br&gt;  → ALB (:80)&lt;br&gt;  → Next.js (:3000)&lt;br&gt;       └ /api/* を localhost:8080 へ転送&lt;br&gt;            → Go API (:8080) → RDS&lt;br&gt;&lt;br&gt;同一オリジンのため CORS 設定が不要" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#DD6B10;fillColor=#FFF8F0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="290" height="175" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="igw" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="振り分け・&lt;br&gt;ヘルスチェック" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ec2_a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="520"/><mxPoint x="800" y="339"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ec2_c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="520"/><mxPoint x="800" y="709"/></Array></mxGeometry></mxCell><mxCell id="e7" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2_a" target="rds_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="SQL&lt;br&gt;(常にプライマリへ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2_c" target="rds_a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="709"/><mxPoint x="1050" y="358"/></Array></mxGeometry></mxCell><mxCell id="e9" value="同期レプリケーション&lt;br&gt;障害時は自動で切替" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C925D1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rds_a" target="rds_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="外向き通信" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.13;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2_a" target="igw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="310"/><mxPoint x="860" y="228"/><mxPoint x="420" y="228"/></Array></mxGeometry></mxCell><mxCell id="e11" value="外向き通信" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2_c" target="igw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="740"/><mxPoint x="860" y="832"/><mxPoint x="420" y="832"/></Array></mxGeometry></mxCell><mxCell id="e12" value="外部APIの呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="igw" target="extbox"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="544"/></Array></mxGeometry></mxCell><mxCell id="e14" value="権限付与(全台)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#DD344C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="iam" target="asg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="950"/><mxPoint x="