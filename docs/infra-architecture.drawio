0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="60" height="60" as="geometry"/></mxCell><mxCell id="iam" value="IAM ロール&lt;br&gt;(EC2に付与)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="560" y="910" width="60" height="60" as="geometry"/></mxCell><mxCell id="ssm" value="Systems Manager&lt;br&gt;Parameter Store" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="780" y="910" width="60" height="60" as="geometry"/></mxCell><mxCell id="cwl" value="CloudWatch Logs" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1010" y="910" width="60" height="60" as="geometry"/></mxCell><mxCell id="user" value="利用者&lt;br&gt;(スマホ / 会社PC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="78" height="78" as="geometry"/></mxCell><mxCell id="r53" value="Route 53&lt;br&gt;独自ドメイン" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="195" y="530" width="60" height="60" as="geometry"/></mxCell><mxCell id="extbox" value="外部サービス (NAT Gateway 経由)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#545B64;fillColor=#FAFAFA;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="300" y="1110" width="560" height="110" as="geometry"/></mxCell><mxCell id="gcal" value="Google&lt;br&gt;Calendar API" style="sketch=0;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;shape=mxgraph.aws4.traditional_server;fillColor=#7D8998;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="345" y="1140" width="50" height="50" as="geometry"/></mxCell><mxCell id="wapi" value="WeatherAPI.com" style="sketch=0;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;shape=mxgraph.aws4.traditional_server;fillColor=#7D8998;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="540" y="1140" width="50" height="50" as="geometry"/></mxCell><mxCell id="wpush" value="Web Push&lt;br&gt;(FCM等)" style="sketch=0;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;shape=mxgraph.aws4.traditional_server;fillColor=#7D8998;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="735" y="1140" width="50" height="50" as="geometry"/></mxCell><mxCell id="sgnote" value="セキュリティグループ&lt;br&gt;&lt;br&gt;ALB  : 443 ← インターネット&lt;br&gt;EC2  : 3000 ← ALB のSGのみ&lt;br&gt;RDS  : 5432 ← EC2 のSGのみ&lt;br&gt;&lt;br&gt;Go API の 8080 はインスタンス内部&lt;br&gt;からのみ使用し、外部に公開しない" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#545B64;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="230" height="160" as="geometry"/></mxCell><mxCell id="flownote" value="インスタンス内部の流れ&lt;br&gt;&lt;br&gt;ALB → Next.js(:3000)&lt;br&gt;       └ /api/* を localhost:8080 へ転送&lt;br&gt;            → Go API(:8080) → RDS&lt;br&gt;&lt;br&gt;同一オリジンのため CORS 設定が不要" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#DD6B10;fillColor=#FFF8F0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="230" height="150" as="geometry"/></mxCell><mxCell id="e1" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;" edge="1" parent="1" source="user" target="r53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounde